{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "Frontend",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- Frontend vercel.json",
  "cleanUrls": true,
  "headers": [
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
